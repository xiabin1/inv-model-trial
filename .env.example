# Copy to .env and fill in (never commit .env). Values with spaces need quotes.
DATABENTO_API_KEY=your_databento_api_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id                     # python -m src.notify.telegram chat-id
SEC_USER_AGENT="portfolio-calc-data your@contact"  # SEC EDGAR asks automated clients for a contact
# IBKR login: ~/ibc/config.ini (IbLoginId / IbPassword / TradingMode), outside this project
